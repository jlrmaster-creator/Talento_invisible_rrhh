# Configuracion publica de Firebase Authentication para la compilacion.
#
# IMPORTANTE: este archivo NO contiene secretos. La `apiKey` de Firebase es un
# identificador publico del proyecto web; la seguridad real la dan los dominios
# autorizados y, si algun dia hay servicios de datos, las Security Rules.
#
# Vite carga automaticamente `.env.production` al ejecutar `npm run build`, de
# modo que el despliegue en GitHub Pages funciona sin configuracion adicional.
#
# Si usas otro proyecto de Firebase, sustituye estos valores. Para desarrollo
# local, crea `.env.local` (ignorado por git) con los mismos nombres.
#
# No pongas aqui claves privadas, credenciales de servicio ni secretos.

VITE_FIREBASE_API_KEY=AIzaSyAl4ixLhH4MZ8_zMIhEm50hqDBcCz4xiso
VITE_FIREBASE_AUTH_DOMAIN=talento-invisible-rrhh.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=talento-invisible-rrhh
VITE_FIREBASE_STORAGE_BUCKET=talento-invisible-rrhh.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=743104084277
VITE_FIREBASE_APP_ID=1:743104084277:web:8d34db31881fd7e809b47c
